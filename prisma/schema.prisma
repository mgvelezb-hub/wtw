generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────────
enum ProjectType {
  facturable
  interno
  desarrollo
}

enum ProjectStatus {
  activo
  pausado
  cerrado
}

enum BlockType {
  tarea
  junta
  hito
  descanso // "break" en el tablero viejo
}

enum TaskStatus {
  backlog
  planned
  in_progress
  done
  deferred
  // Delegada de verdad: la hace alguien más. Distinta de `delegable`, que es la
  // bitácora de "la hice YO y debió hacerla un perfil más junior". Una sale de
  // la carga de Mau; la otra es el caso de negocio para pedir ese perfil.
  delegada
}

enum WeekStatus {
  planning
  active
  closed
}

enum WinStatus {
  pendiente
  logrado
  fallido
}

enum DeliverableStatus {
  borrador
  rev_interna
  rev_cliente
  aceptado
}

enum IssueStatus {
  abierto
  cerrado
}

enum IssueTipo {
  riesgo
  pendiente
  acuerdo
  decision
  cambio // change control light: modificaciones al plan de trabajo
}

enum CompetencyType {
  individual
  rol
  // Reactivos de la sección 2 del instrumento de VP: comportamientos esperados
  // POR NIVEL. `grupo` guarda el nombre del nivel y `orden` el número del
  // reactivo en el documento, para poder decir "el reactivo 10 de Gerente".
  nivel
}

enum Alcance {
  sow // comprometido en el plan de trabajo
  aliado // valor adicional intencional — inversión en la alianza (diferencial VP)
}

// Clase de referencia del factor de realismo. Un factor global no calibra: la
// sobre-optimización de armar un deck no se parece a la de preparar una junta.
// El factor solo corrige si se mide POR TIPO DE TRABAJO y se re-inyecta en la
// siguiente estimación. Nullable en Task — el histórico no lo trae y no se
// inventa retroactivamente.
enum TipoTrabajo {
  deck
  analisis
  junta
  gestion
  comunicacion
  otro
}

enum MinutaItemTipo {
  acuerdo
  decision
  pendiente_nuestro // accionable interno → promovible a Task
  pendiente_cliente // espera de tercero → promovible a Issue
  solicitud_data // caso especial de espera; ciclo de vida completo en Fase C
  actividad_nueva // trabajo no previsto → promovible a Task (evaluar alcance sow/aliado)
  riesgo // → promovible a Issue tipo riesgo
  nota
}

enum MinutaItemEstado {
  abierto
  cerrado
  convertido // ya vive como Task o Issue; la minuta conserva el registro histórico
}

enum ArtifactTipo {
  status_equipo // Fase A
  brief_junta // Fase C
  status_cliente_texto // Fase C — narrativa para el portal, complementa el scorecard
  // Resumen con IA de alcance variable: una junta, un periodo, un día, una
  // semana, un proyecto o global. Cruza minutas capturadas con tareas, issues y
  // entregables abiertos — ver src/app/(app)/resumen/service.ts
  resumen_minuta
}

enum ArtifactEstado {
  borrador // generado, sin tocar
  editado // el usuario guardó una versión final
  enviado // el usuario lo copió/mandó (señal de aceptación)
  descartado
}

// ── Capa 1: Ejecución personal ─────────────────────────
model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  nombre               String
  passwordHash         String
  apiTokenHash         String?               @unique // sha256 del PAT
  horarioInicio        String                @default("09:00")
  horarioFin           String                @default("18:00")
  comidaInicio         String                @default("14:00")
  comidaFin            String                @default("15:00")
  bufferPct            Int                   @default(25)
  factorManual         Decimal?              @db.Decimal(4, 2) // override; el auto se calcula de TimeEntries
  icsUrl               String?
  timezone             String                @default("America/Mexico_City")
  nivelActualId        String?
  nivelObjetivoId      String?
  managerId            String?
  nivelActual          Level?                @relation("actual", fields: [nivelActualId], references: [id])
  nivelObjetivo        Level?                @relation("objetivo", fields: [nivelObjetivoId], references: [id])
  manager              User?                 @relation("management", fields: [managerId], references: [id])
  reports              User[]                @relation("management")
  weeks                Week[]
  tasks                Task[]
  timeEntries          TimeEntry[]
  calendarEvents       CalendarEvent[]
  projects             Project[]
  evidences            Evidence[]
  dayOverrides         DayOverride[]
  allocations          Allocation[]
  minutas              Minuta[]
  artifacts            Artifact[]
  stakeholders         Stakeholder[]
  aprendizaje          LearningProgress[]
  cierres              DayReconciliation[]
  propuestasLiteratura PropuestaLiteratura[]
  pushSubs             PushSub[]
  recordatorios        Json?                 // { ritual: "dom 18:00" | null, cierre: "17:30" | null } — ver lib/push
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Week {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  isoWeek         String // "2026-W27"
  rangoInicio     DateTime   @db.Date
  rangoFin        DateTime   @db.Date
  factorUsado     Decimal    @db.Decimal(4, 2)
  reflexion       String?
  desbloqueador   String? // la actividad clave que destraba la semana (chip dorado)
  estatus         WeekStatus @default(planning)
  horarioOverride String?
  wins            Win[]
  tasks           Task[]
  blocks          Block[]
  riesgos         WeekRisk[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([userId, isoWeek])
}

model Win {
  id         String    @id @default(cuid())
  weekId     String
  week       Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  posicion   Int // 1-3
  titulo     String
  dod        String?
  // Plan de implementación del Win: "Si <obstáculo>, entonces <acción>". Se
  // define en el paso 2 del planeador y se REPASA en /semana — el efecto del
  // si-entonces viene de tenerlo ensayado ANTES de que llegue el obstáculo, no
  // de haberlo escrito una vez. Nullable: los Wins que ya existen, y los que
  // entran por POST /weeks o por la skill, no lo traen.
  siEntonces String?
  estatus    WinStatus @default(pendiente)
  tasks      Task[]

  @@unique([weekId, posicion])
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id])
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id])
  winId         String?
  win           Win?         @relation(fields: [winId], references: [id])
  weekId        String?
  week          Week?        @relation(fields: [weekId], references: [id])
  titulo        String
  estimadoMin   Int?
  ajustadoMin   Int?
  deadline      DateTime?    @db.Date
  estatus       TaskStatus   @default(backlog)
  alcance       Alcance      @default(sow)
  dolorCliente  String? // qué dolor del cliente atiende (requerido en UI/skill si alcance=aliado)
  urgente       Boolean      @default(false) // pendiente urgente no agendado (panel derecho, ★)
  // Bitacora de delegacion: esta tarea la hizo Mau pero deberia haberla hecho
  // alguien mas junior. Sin reportes no hay a quien asignarla — el registro es el
  // caso de negocio con VP para pedir uno, que es el desbloqueo real de dos de las
  // tres expectativas de Gerente.
  delegable     Boolean      @default(false)
  delegableNota String? // a que perfil, y por que no se delego
  // A quién se delegó, cuando estatus = delegada. Sin nombre la delegación no
  // es seguimiento de nadie: es solo trabajo que desapareció de la vista.
  delegadoA     String?
  herramienta   String? // Excel, PowerPoint, Python, Power BI, AnyLogic... determina complejidad/estimación
  tipoTrabajo   TipoTrabajo? // clase de referencia para el factor de realismo (ver enum)
  dodItems      DodItem[]
  blocks        Block[]
  timeEntries   TimeEntry[]
  evidences     Evidence[]
  competencias  Competency[] @relation("TaskCompetencias") // etiquetado al planear
  minutaItems   MinutaItem[]
  desvios       Desvio[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model DodItem {
  id     String  @id @default(cuid())
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  texto  String
  done   Boolean @default(false)
  orden  Int     @default(0)
}

model Block {
  id        String    @id @default(cuid())
  weekId    String
  week      Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id])
  fecha     DateTime  @db.Date
  inicio    String // "09:00" | "flex"
  fin       String
  tipo      BlockType
  titulo    String // denormalizado para juntas/breaks sin task
  planMin   Int
  done      Boolean   @default(false) // para junta/hito/descanso
  orden     Int       @default(0)
  minutas   Minuta[]
  // Sin estos sellos no había forma de saber qué bloque se movió ni cuándo, y por
  // eso el día 13-ago-2026 quedó irrecuperable tras pasar sus pendientes: los
  // registros son los MISMOS, solo con otra fecha.
  //
  // `updatedAt` lleva `@default(now())` —a diferencia del resto de los modelos—
  // porque esta columna se agrega a una tabla que YA tiene filas en producción:
  // un NOT NULL sin default no puede rellenarlas y la migración fallaría.
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model TimeEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id])
  startedAt DateTime
  stoppedAt DateTime?
  seconds   Int       @default(0) // calculado al stop
  manual    Boolean   @default(false) // corregido/agregado a mano — honestidad de datos

  @@index([userId, stoppedAt])
}

model CalendarEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  externalId String // UID del ICS
  fecha      DateTime @db.Date
  inicio     String
  fin        String
  titulo     String
  cancelado  Boolean  @default(false)
  bloqueante Boolean  @default(true) // false: visible pero informativo (ej. compartido solo para dar visibilidad) — no resta capacidad ni es obstáculo del reflow
  updatedAt  DateTime @updatedAt
  minutas    Minuta[]

  @@unique([userId, externalId])
}

model DayOverride {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  fecha  DateTime @db.Date
  inicio String? // null = día no laborable (vacaciones/festivo)
  fin    String?
  nota   String? // "vuelo a Cancún", "festivo", "jornada 9-21"

  @@unique([userId, fecha])
}

model Allocation {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  pct          Int // % objetivo de dedicación
  vigenteDesde DateTime  @db.Date
  vigenteHasta DateTime? @db.Date // null = vigente

  @@index([userId, vigenteDesde])
}

// ── Capa 2: Engagement ─────────────────────────────────
model Project {
  id                     String        @id @default(cuid())
  userId                 String // owner (v1); fase equipo agrega members
  user                   User          @relation(fields: [userId], references: [id])
  nombre                 String
  cliente                String?
  color                  String        @default("#0A7C82")
  tipo                   ProjectType   @default(facturable)
  estatus                ProjectStatus @default(activo)
  fechaInicio            DateTime?     @db.Date
  fechaFin               DateTime?     @db.Date
  presupuestoHoras       Decimal?      @db.Decimal(7, 2)
  tarifaHora             Decimal?      @db.Decimal(12, 2)
  origen                 String? // recompra derivada de qué relación/proyecto — ROI de alianza
  presupuestoAliadoHoras Decimal?      @db.Decimal(7, 2) // gobernanza de inversión aliado
  portalTokenHash        String?       @unique // hash del magic-link del portal cliente
  allocations            Allocation[]
  deliverables           Deliverable[]
  issues                 Issue[]
  tasks                  Task[]
  minutas                Minuta[]
  artifacts              Artifact[]
  stakeholders           Stakeholder[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@unique([userId, nombre])
}

model Deliverable {
  id                String              @id @default(cuid())
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  numeroSow         String?
  nombre            String
  hipotesis         String? // answer-first: respuesta esperada
  fechaInicio       DateTime?           @db.Date // para la curva de avance proyectado
  fechaComprometida DateTime?           @db.Date // baseline SOW — inmutable
  fechaProyectada   DateTime?           @db.Date // forecast vivo
  avancePct         Int                 @default(0) // declarado, no derivado (práctica PMO)
  presupuestoHoras  Decimal?            @db.Decimal(7, 2)
  estatus           DeliverableStatus   @default(borrador)
  alcance           Alcance             @default(sow)
  cartaUrl          String?
  // Un entregable PRESENTADO en persona es evidencia de "Quien presenta" y de "La
  // mano del Rey"; uno enviado por correo no es evidencia de ninguno de los dos.
  presentado        Boolean             @default(false)
  presentadoA       String? // quien estuvo en la sala
  tasks             Task[]
  evidences         Evidence[]
  impactos          ImpactoEntregable[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

// Mini-BRM por entregable: el antes/después medible que justifica la renovación
// con el cliente y, a la vez, es evidencia de Client Leadership para el
// promotion case. Cuelga de Deliverable (cascade), que cuelga de Project
// (cascade); Project→User NO cascadea a nivel DB, pero tests/helpers/cleanup.ts
// ya borra Deliverable explícitamente antes de Project — el cascade de FK en
// Postgres se dispara con ese delete y arrastra ImpactoEntregable sin que
// cleanup.ts necesite tocarlo.
model ImpactoEntregable {
  id            String      @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  fecha         DateTime    @default(now())
  baseline      String // el punto de partida medible ("fill rate 71%")
  delta         String // el cambio logrado ("→ 78.4%, +$12 MM anualizados")
  validadoPor   String? // quién del lado cliente lo validó
  nota          String?
}

model Issue {
  id                String       @id @default(cuid())
  projectId         String
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tipo              IssueTipo    @default(pendiente) // RAID completo en una tabla
  tema              String?
  descripcion       String
  responsable       String? // interno o del cliente ("Apoyo Requerido" del status)
  fechaCompromiso   DateTime?    @db.Date
  estatus           IssueStatus  @default(abierto)
  ownerId           String? // usuario interno que persigue el issue (multiplayer-ready)
  ultimoSeguimiento DateTime? // último chase — habilita "van 3 semanas sin respuesta"
  numSeguimientos   Int          @default(0)
  minutaItems       MinutaItem[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ── Capa 4: Desarrollo profesional ─────────────────────
model Level {
  id            String  @id @default(cuid())
  nombre        String  @unique // Analista, Consultor Sr, Gerente, Gerente Sr
  orden         Int     @unique
  expectativas  String?
  usersActual   User[]  @relation("actual")
  usersObjetivo User[]  @relation("objetivo")
}

enum RecursoTipo {
  libro
  curso
  platica
  articulo
  ejercicio // el único tipo que se practica en vez de consumirse
}

enum RecursoEstado {
  pendiente
  en_curso
  hecho
  descartado // se evaluó y no aplica — distinto de nunca haberlo tocado
}

// Catálogo de material de desarrollo. Cada recurso cuelga de las competencias que
// sirve, para que aparezca DONDE está el hueco en vez de vivir en una lista
// aparte que se lee una vez y muere. Ver docs/plans/2026-08-10-alineacion-council.md
// §Fase 2b — y recordar que esto es el 10% del 70-20-10: su única función es que
// la práctica sea deliberada en lugar de repetitiva.
model LearningResource {
  id           String             @id @default(cuid())
  tipo         RecursoTipo
  titulo       String
  fuente       String? // autor, institución o programa
  url          String?
  porQue       String // una frase: por qué este recurso mueve esta competencia
  // Solo para ejercicios: cuánto toma y con qué cadencia se repite.
  duracionMin  Int?
  cadencia     String? // "semanal" | "por entregable" | "por junta" | "una vez"
  orden        Int                @default(0)
  competencias Competency[]       @relation("RecursoCompetencias")
  progresos    LearningProgress[]

  @@unique([tipo, titulo])
}

// Progreso por usuario. Sin esto el catálogo no puede distinguir "no lo he hecho"
// de "lo hice", que es justo la diferencia que vuelve accionable a una lista.
model LearningProgress {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  resourceId String
  resource   LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  estado     RecursoEstado    @default(pendiente)
  nota       String?
  iniciado   DateTime?
  terminado  DateTime?
  // Para ejercicios recurrentes: cuántas veces se ha practicado.
  veces      Int              @default(0)
  updatedAt  DateTime         @updatedAt

  @@unique([userId, resourceId])
  @@index([userId, estado])
}

// Mapa de stakeholders. Dos roles VP completos ("La mano del Rey", "La estrategia
// que renovará al Estado") y la tercera expectativa de Gerente —proximidad con
// stakeholders— dependen de esto. Hoy los stakeholders de Liverpool viven como
// texto libre dentro de títulos de tareas y en Minuta.asistentes.
model Stakeholder {
  id            String                   @id @default(cuid())
  userId        String
  user          User                     @relation(fields: [userId], references: [id])
  projectId     String?
  project       Project?                 @relation(fields: [projectId], references: [id])
  nombre        String
  puesto        String?
  // Poder e interés en escala 1-3. Sirven para la matriz clásica de influencia:
  // poder alto + interés alto = gestión cercana; poder alto + interés bajo = el
  // que te hunde el proyecto sin avisar.
  poder         Int                      @default(2)
  interes       Int                      @default(2)
  // Los otros dos atributos del modelo de saliencia (Mitchell/Agle/Wood, 1997). El
  // poder ya vivía aquí en escala 1-3; legitimidad y urgencia son binarios porque
  // eso es lo que son en el modelo: el reclamo es legítimo o no lo es. Los tres
  // juntos dan el tipo de stakeholder (definitivo / expectante / latente), y ese
  // tipo —no el gusto de cada quien— es lo que fija cada cuánto hay que hablarle.
  legitimidad   Boolean                  @default(false)
  urgencia      Boolean                  @default(false)
  postura       StakeholderPostura       @default(neutral)
  queNecesita   String? // qué necesita ESTA persona para considerar el proyecto un éxito
  // Cada cuántos días debería haber contacto. Null = sin cadencia comprometida.
  cadenciaDias  Int?
  notas         String?
  interacciones StakeholderInteraccion[]
  desvios       Desvio[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([userId, nombre])
  @@index([userId, projectId])
}

model StakeholderInteraccion {
  id                String             @id @default(cuid())
  stakeholderId     String
  stakeholder       Stakeholder        @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  fecha             DateTime           @db.Date
  tipo              InteraccionTipo
  nota              String?
  // Cuál de las cuatro variables de la Trust Equation (Maister) movió este
  // contacto. Null = hubo contacto pero no construyó confianza: cumple la cadencia
  // y nada más. Distinguirlo importa porque "le hablé" y "avancé la relación" son
  // cosas distintas y solo la segunda se acumula.
  variableConfianza VariableConfianza?
  // Un compromiso roto CON esta persona. Se guarda en la interacción y no en el
  // stakeholder porque tiene fecha: es un evento, no un atributo. Pesa 3x lo que
  // suma un contacto positivo — la asimetría documentada de la confianza.
  esIncumplimiento  Boolean            @default(false)
  // Si la interacción salió de una junta ya registrada, se liga en vez de duplicar.
  minutaId          String?
  createdAt         DateTime           @default(now())

  @@index([stakeholderId, fecha])
}

enum StakeholderPostura {
  aliado
  neutral
  opositor
  desconocida
}

enum InteraccionTipo {
  junta
  llamada
  correo
  informal
  presentacion
}

// Las cuatro variables de la Trust Equation de Maister:
// confianza = (credibilidad + confiabilidad + intimidad) / auto-orientación.
// La cuarta va como `bajaAutoOrientacion` —en positivo— porque un enum no puede
// tener un denominador: lo que se registra es el contacto donde el interés propio
// se puso en segundo lugar, que es lo que baja el divisor.
enum VariableConfianza {
  credibilidad
  confiabilidad
  intimidad
  bajaAutoOrientacion
}

// Riesgos del pre-mortem (paso 5 del planeador). Antes se generaban y se tiraban:
// solo el desbloqueador se guardaba. Cerrar el ciclo —marcar qué riesgo ocurrió y
// si la defensa sirvió— es evidencia fechada de capacidad predictiva, que es
// literalmente lo que pide "Quien tiene expertise técnico".
model WeekRisk {
  id              String   @id @default(cuid())
  weekId          String
  week            Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  riesgo          String
  defensa         String
  // null = la semana aún no se cierra. No es lo mismo que "no ocurrió".
  ocurrio         Boolean?
  defensaFunciono Boolean?
  nota            String?
  orden           Int      @default(0)
}

model Competency {
  id        String             @id @default(cuid())
  tipo      CompetencyType
  grupo     String? // nombre del rol VP ("La mano del Rey"...) — null para individuales
  texto     String // el reactivo
  orden     Int
  tasks     Task[]             @relation("TaskCompetencias")
  evidences Evidence[]
  recursos  LearningResource[] @relation("RecursoCompetencias")

  @@unique([tipo, grupo, orden])
}

model Evidence {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  competencyId    String
  competency      Competency   @relation(fields: [competencyId], references: [id])
  taskId          String?
  task            Task?        @relation(fields: [taskId], references: [id])
  deliverableId   String?
  deliverable     Deliverable? @relation(fields: [deliverableId], references: [id])
  nota            String
  // Quién puede corroborarlo — nombre de una persona, típicamente el stakeholder
  // o el cliente. Sin testigo un episodio es palabra contra palabra frente al
  // comité; con nombre es verificable.
  testigo         String?
  // A qué nivel del escalafón operaste en ESE episodio. La regla de oro del
  // comité es demostrar que YA operas en el siguiente nivel, no que podrías.
  nivelDemostrado String?
  createdAt       DateTime     @default(now())
}

// ── Captura: minutas por junta ────────────────────────

model Minuta {
  id              String         @id @default(cuid())
  userId          String // quien captura
  user            User           @relation(fields: [userId], references: [id])
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blockId         String? // junta del tablero (Block tipo junta)
  block           Block?         @relation(fields: [blockId], references: [id])
  calendarEventId String? // o junta del calendario Outlook sincronizado
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id])
  fecha           DateTime       @db.Date
  titulo          String // denormalizado de la junta; editable
  asistentes      String[] // nombres libres — insumo del mapa de stakeholders (Fase C)
  notas           String? // texto libre pre-clasificación (dictado/pegado, V2)
  items           MinutaItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId, fecha])
}

model MinutaItem {
  id                String           @id @default(cuid())
  minutaId          String
  minuta            Minuta           @relation(fields: [minutaId], references: [id], onDelete: Cascade)
  tipo              MinutaItemTipo
  texto             String // SIEMPRE texto plano: es lo que consumen la promoción a Task/Issue
  // (titulo/descripcion) y el ensamblador de la IA. Nunca guardar markup aquí.
  textoRich         String? // HTML del editor enriquecido, cuando el item se capturó con formato.
  // La UI lo prefiere para mostrar; si es null cae a `texto`.
  responsable       String? // nombre libre (tercero del cliente o interno)
  responsableUserId String? // si el responsable es usuario de la app (multiplayer-ready)
  fechaCompromiso   DateTime?        @db.Date
  estado            MinutaItemEstado @default(abierto)
  orden             Int              @default(0)
  taskId            String? // destino si se promovió a Task
  task              Task?            @relation(fields: [taskId], references: [id])
  issueId           String? // destino si se promovió a Issue
  issue             Issue?           @relation(fields: [issueId], references: [id])
  createdAt         DateTime         @default(now())
}

// ── Artefactos generados: el flywheel de aprendizaje ──

model Artifact {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id])
  tipo          ArtifactTipo
  audiencia     String? // "equipo" | "cliente" | nombre de junta (brief)
  rangoDesde    DateTime? // ventana de insumos cubierta
  rangoHasta    DateTime?
  insumos       Json // snapshot de IDs y hechos usados — trazabilidad y evals
  borrador      String // salida cruda del modelo — NUNCA se sobrescribe
  final         String? // texto tras edición humana — el otro lado del diff
  estado        ArtifactEstado @default(borrador)
  modelo        String // id exacto del modelo usado
  promptVersion String // versión de la plantilla — para atribuir regresiones
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, projectId, tipo, createdAt])
}

// ── Reconciliación de cierre de día ───────────────────
//
// El cronómetro SIGUE siendo el instrumento primario: es el dato honesto y es la
// disciplina a desarrollar (cronometrar es parte de la rúbrica que hay que
// demostrar). Esto no lo reemplaza, lo AUDITA. Su propósito es capturar POR QUÉ
// se rompió el plan, que en este trabajo es la mitad de la información y hoy se
// pierde completa. Ver docs/plans/2026-08-10-alineacion-council.md §Fase 1.
//
// La ausencia de desvíos no es un registro vacío: significa que el plan se
// cumplió. Por eso el hecho de que exista la fila ya es la señal, y no hace falta
// una causa "todo salió bien".

model DayReconciliation {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  fecha           DateTime  @db.Date
  nota            String?
  // Snapshot tomado al pasar los pendientes al día siguiente. Es necesario porque
  // mover un bloque le cambia `fecha` EN EL MISMO registro, y el cálculo de lo
  // planeado lee bloques por fecha: sin esto, cerrar el día borra la evidencia de
  // qué se había planeado y el día queda en cero para siempre. Null = todavía no
  // se pasaron pendientes, y entonces se calcula en vivo.
  planMinCierre   Int?
  medidoMinCierre Int?
  // Cuántos bloques se movieron y a qué día. Se guarda para poder responder
  // "¿qué pasó el lunes?" sin depender de la memoria.
  movidos         Int?
  movidosA        DateTime? @db.Date
  desvios         Desvio[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, fecha])
  @@index([userId, fecha])
}

model Desvio {
  id               String            @id @default(cuid())
  reconciliationId String
  reconciliation   DayReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  causa            DesvioCausa
  minutos          Int
  // De qué stakeholder vino la urgencia. Sin esto "bomberazo" es un conteo; con
  // esto es evidencia fechada para renegociar alcance, no percepción.
  stakeholderId    String?
  stakeholder      Stakeholder?      @relation(fields: [stakeholderId], references: [id])
  // La tarea que se trabajó sin cronometrar, cuando aplica. Es lo que distingue
  // "no lo hice" de "lo hice y no lo medí".
  taskId           String?
  task             Task?             @relation(fields: [taskId], references: [id])
  nota             String?
  orden            Int               @default(0)

  @@index([reconciliationId])
}

enum DesvioCausa {
  bomberazo // urgencia no planeada
  cambio_prioridad_cliente // insumo directo para renegociar alcance
  junta_se_alargo // corrige la capacidad real, hoy calculada del calendario nominal
  trabajo_sin_cronometro // dato de disciplina: la reconciliación no perdona el cronómetro
}

// ── Perfiles IA (fundación; destilación automática en Fase C) ──

model AiProfile {
  id        String   @id @default(cuid())
  userId    String? // perfiles de usuario (voz, rutina)
  projectId String? // perfiles de proyecto (project brief)
  tipo      String // "voice_status_equipo" | "routine" | "project_brief" | ...
  contenido Json // el perfil es VISIBLE Y EDITABLE por el usuario — nunca caja negra
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([userId, projectId, tipo])
}

// ── Observabilidad de costos IA ───────────────────────

model AiCall {
  id           String   @id @default(cuid())
  userId       String
  feature      String // "status_equipo" | "clasificar_minuta" | ...
  modelo       String
  inputTokens  Int
  outputTokens Int
  // Sin estas dos columnas un truncado y una respuesta mal formateada se ven
  // IDÉNTICOS en el log, y el banner de la UI dice lo mismo en los dos casos.
  // Diagnosticar el bug del 2026-08-24 costó reproducir la llamada contra la API
  // para leer un stop_reason que ya habíamos tenido en la mano. `thinkingTokens`
  // va aparte porque es lo que suele agotar el presupuesto: es la resta que
  // explica por qué el texto llegó corto.
  stopReason   String? // "end_turn" | "max_tokens" | "stop_sequence" | null si falló antes
  thinkingTokens Int    @default(0)
  ms           Int
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// Log de propuestas desde literatura o experiencias en otros proyectos —
// reactivo 11 de Gerente ("propone soluciones a partir de literatura o
// experiencias en otros proyectos"). Es el criterio más fácil de perder en el
// ruido: la idea se lee un martes, se propone en una junta tres semanas
// después y nadie la conecta con la fuente. El log es vivo — se registra la
// idea al momento y se completa qué pasó cuando se sabe, que suele ser
// semanas después. Sin cascada desde User: entrada obligatoria en
// tests/helpers/cleanup.ts (regla 7 de CLAUDE.md).
model PropuestaLiteratura {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  insight      String // la idea o patrón
  fuente       String // libro, paper, u otro proyecto donde lo viste
  dondePropuse String? // proyecto/junta donde lo propusiste
  queParo      String? // qué pasó: se adoptó, se descartó, en evaluación
  fecha        DateTime @default(now())

  @@index([userId, fecha])
}

// Suscripción de Web Push de UN dispositivo (el iPad, el teléfono, el
// escritorio). Una persona tiene varias y cada una caduca por su cuenta: el
// endpoint es la identidad, y cuando el servicio de push responde 404/410 la
// fila se borra — reintentar contra un endpoint muerto es lo que hace que las
// notificaciones se acumulen y luego lleguen todas juntas.
model PushSub {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  // Para saber qué dispositivo desuscribir desde Ajustes sin descifrar nada.
  etiqueta  String?
  createdAt DateTime @default(now())
  usadoEn   DateTime?

  @@index([userId])
}
